# Engine binaries and the scratch clone are never committed.
engine/*
!engine/.gitkeep
tmp/
logs/
# Screenshots the README shows are committed; everything else under data/ is local.
data/*
!data/media/
!data/media/*.png

# The distilled history archive is part of the project: a clone needs the topic files,
# the notes and the index, or standing task 1 has nothing to work from. The raw
# transcripts (114 MB on this box) and the builder's stale scratch stay on the machine
# that produced them.
!data/history/
data/history/*
!data/history/README.md
!data/history/chats/
!data/history/chats/**
!data/history/topics/
!data/history/topics/**
!data/history/notes/
!data/history/notes/**
!data/history/index.json
!data/history/sources.md
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Tuning output and machine-specific history stay on the box that produced them.
# The seed-* priors are the exception: they are the measured configurations from a
# reference machine, trimmed to the best few, and shipped so a first sweep is not cold.
optuna_tune/results/*
optuna_tune/history/*
!optuna_tune/history/seed-*.json

# Local run configs and the API key. The example is the template a new config is
# copied from; the real ones name absolute paths on one particular box.
config/run-*.json
config/run-*.sh
!config/run-example.json
.env

# Runtime logs the app writes to itself.
serve/assist_calls.jsonl

# The MCP test loop's own progress file. It is this machine's working state, not
# part of the project.
.mcp_test_state.json
