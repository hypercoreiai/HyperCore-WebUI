# Copy to .env. Nothing here is required to start the WebUI.

# Assist tab: any OpenAI-compatible endpoint.
ENDPOINT=https://integrate.api.nvidia.com/v1
API_KEY=

# Server defaults (the Config view in the web app overrides these).
HYPERCORE_HOST=0.0.0.0
HYPERCORE_PORT=8081
HYPERCORE_API_KEY=0000

# Engine discovery, used only if no run config names an exe.
STRATA_ENGINE=

# Attach mode: talk to an engine another server already loaded instead of
# starting a second copy of the model.
HYPERCORE_ENGINE_URL=

# Build tab: how often to check Niko1221/Strata for a new release, in minutes.
HYPERCORE_UPDATE_CHECK_MINUTES=60
