#!/usr/bin/env python3
"""Run every MCP tool test and print one standardized report.

    python3 serve/mcp/tests/run_all.py                        # every server
    python3 serve/mcp/tests/run_all.py --server terminal      # one server
    python3 serve/mcp/tests/run_all.py --no-live              # skip network/browser cases
    python3 serve/mcp/tests/run_all.py --verbose              # every case, not just the failures
    python3 serve/mcp/tests/run_all.py --json /tmp/report.json
    python3 serve/mcp/tests/run_all.py --compare previous.json

The report shape never changes, so a retest can be compared with the one before it:
per server, per tool, how many cases ran and how many passed.  Exit code 0 only when
nothing failed or errored.

Each test method is tagged with @case(server, tool, what it checks), so the report is
grouped by server and tool rather than by file.  A tool that is advertised by its
server but has no case is listed as uncovered.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
import unittest
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))

from serve.mcp.tests import harness

MODULES = ["test_contracts", "test_terminal", "test_scrape", "test_docs", "test_home", "test_web",
         "test_hub"]
DEFAULT_REPORT = Path("/home/ai-agent/.terminal/retest_report.json")
OUTCOMES = ("pass", "fail", "error", "skip")


class Recorder(unittest.TestResult):
    """Collect one row per test method, keyed by the server and tool it covers."""

    def __init__(self, stream=None):
        super().__init__(stream)
        self.rows: list[dict] = []
        self.started: dict[str, float] = {}
        self.duration: dict[str, int] = {}

    @staticmethod
    def _meta(test) -> dict:
        """The @case tag lives on the test method, not on the TestCase instance."""
        method = getattr(test, getattr(test, "_testMethodName", ""), None)
        meta = getattr(method, "case", None)
        if meta is None:
            name = getattr(test, "_testMethodName", str(test))
            meta = {"server": "unknown", "tool": "untagged", "name": name}
        return meta

    def _row(self, test, outcome, note):
        meta = self._meta(test)
        key = getattr(test, "_testMethodName", "")
        ms = self.duration.get(key) or int((time.monotonic() - self.started.get(key, time.monotonic())) * 1000)
        self.rows.append({
            "server": meta["server"],
            "tool": meta["tool"],
            "case": meta["name"],
            "test": f"{type(test).__name__}.{test._testMethodName}",
            "outcome": outcome,
            "note": note,
            "ms": ms,
        })

    def startTest(self, test):
        super().startTest(test)
        self.started[getattr(test, "_testMethodName", "")] = time.monotonic()

    def stopTest(self, test):
        key = getattr(test, "_testMethodName", "")
        if key in self.started:
            self.duration[key] = int((time.monotonic() - self.started[key]) * 1000)
        super().stopTest(test)

    def addSuccess(self, test):
        super().addSuccess(test)
        self._row(test, "pass", "")

    def addFailure(self, test, err):
        super().addFailure(test, err)
        self._row(test, "fail", _first_line(err))

    def addError(self, test, err):
        super().addError(test, err)
        self._row(test, "error", _first_line(err))

    def addSkip(self, test, reason):
        super().addSkip(test, reason)
        self._row(test, "skip", str(reason))


def _first_line(err) -> str:
    text = str(err[1] if isinstance(err, tuple) else err).strip()
    return text.splitlines()[-1][:200] if text else ""


def advertised(module) -> list[str]:
    """The tool list a module declares, so the report can show what is not covered."""
    names = getattr(module, "ADVERTISED", None)
    return sorted(names) if isinstance(names, list) else []


def build_suite(only: str | None) -> unittest.TestSuite:
    suite = unittest.TestSuite()
    for name in MODULES:
        if only and name != f"test_{only}":
            continue
        module = __import__(f"serve.mcp.tests.{name}", fromlist=[name])
        suite.addTests(unittest.defaultTestLoader.loadTestsFromModule(module))
    return suite


def aggregate(rows: list[dict], coverage: dict[str, list[str]]) -> dict:
    servers: dict[str, dict] = {}
    for row in rows:
        s = servers.setdefault(row["server"], {
            "advertised": coverage.get(row["server"], []),
            "cases": 0, "pass": 0, "fail": 0, "error": 0, "skip": 0,
            "elapsed_ms": 0, "tools": {}, "failures": [],
        })
        s["cases"] += 1
        s[row["outcome"]] = s.get(row["outcome"], 0) + 1
        s["elapsed_ms"] += row["ms"]
        t = s["tools"].setdefault(row["tool"], {"cases": 0, "pass": 0, "fail": 0, "error": 0, "skip": 0,
                                               "slowest_ms": 0})
        t["cases"] += 1
        t[row["outcome"]] = t.get(row["outcome"], 0) + 1
        t["slowest_ms"] = max(t["slowest_ms"], row["ms"])
        if row["outcome"] in ("fail", "error"):
            s["failures"].append({"tool": row["tool"], "case": row["case"], "note": row["note"]})
    for s in servers.values():
        s["tools_tested"] = sorted(t for t, c in s["tools"].items() if c["cases"] and t != "untagged")
        s["tools_covered"] = len(s["tools_tested"])
        s["ok"] = s["fail"] == 0 and s["error"] == 0
    return servers


def uncovered(servers: dict) -> list[str]:
    out = []
    for name, s in servers.items():
        for tool in s["advertised"]:
            if tool not in s["tools"]:
                out.append(f"{name}.{tool}")
    return sorted(out)


def print_report(report: dict, verbose: bool) -> None:
    print(f"HyperCore MCP tool retest  {report['generated']}  python {report['python']}  "
          f"live={report['live']}  {report['totals']['elapsed_ms'] // 1000} s")
    head = f"{'server':<12}{'tools':>7}{'cases':>7}{'pass':>7}{'fail':>6}{'error':>7}{'skip':>6}  status"
    print(head)
    print("-" * len(head))
    for name, s in sorted(report["servers"].items()):
        print(f"{name:<12}{s['tools_covered']:>7}{s['cases']:>7}{s['pass']:>7}{s['fail']:>6}"
              f"{s['error']:>7}{s['skip']:>6}  {'OK' if s['ok'] else 'FAIL'}")
    t = report["totals"]
    print(f"{'TOTAL':<12}{'':>7}{t['cases']:>7}{t['pass']:>7}{t['fail']:>6}{t['error']:>7}{t['skip']:>6}"
          f"  {'OK' if t['ok'] else 'FAIL'}")

    for name, s in sorted(report["servers"].items()):
        for f in s["failures"]:
            print(f"  FAIL {name}.{f['tool']}: {f['case']}\n        {f['note']}")
        for tool, counts in sorted(s["tools"].items()):
            if counts["skip"]:
                print(f"  SKIP {name}.{tool}: {counts['skip']} case(s)")
    if report["uncovered"]:
        print(f"tools with no test case: {', '.join(report['uncovered'])}")
    else:
        print("every advertised tool has at least one case")
    print(f"report written to {report['report_path']}")
    if verbose:
        for row in report["rows"]:
            print(f"  {row['outcome']:>5} {row['server']}.{row['tool']}: {row['case']} ({row['ms']} ms)")


def diff_with(previous: dict, report: dict) -> list[str]:
    """Line-by-line differences between two reports, per server and per tool."""
    lines = []
    for key in ("cases", "pass", "fail", "error", "skip"):
        before = previous["totals"].get(key, 0)
        after = report["totals"].get(key, 0)
        if before != after:
            lines.append(f"total {key}: {before} -> {after}")
    for name in sorted(set(previous["servers"]) | set(report["servers"])):
        a, b = previous["servers"].get(name), report["servers"].get(name)
        if a is None:
            lines.append(f"server {name}: new ({b['cases']} cases)")
            continue
        if b is None:
            lines.append(f"server {name}: not run this time")
            continue
        for key in ("pass", "fail", "error", "skip"):
            if a.get(key, 0) != b.get(key, 0):
                lines.append(f"server {name} {key}: {a.get(key, 0)} -> {b.get(key, 0)}")
        for tool in sorted(set(a["tools"]) | set(b["tools"])):
            ta = {k: a["tools"].get(tool, {}).get(k, 0) for k in OUTCOMES}
            tb = {k: b["tools"].get(tool, {}).get(k, 0) for k in OUTCOMES}
            if ta != tb:
                changes = ", ".join(f"{k} {ta[k]}->{tb[k]}" for k in OUTCOMES if ta[k] != tb[k])
                lines.append(f"tool {name}.{tool}: {changes}")
    return lines


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--server", help="only one: contracts, terminal, docs, home, scrape, web, hub")
    ap.add_argument("--json", default=str(DEFAULT_REPORT), help="where to write the report")
    ap.add_argument("--compare", help="a previous report to diff against")
    ap.add_argument("--no-live", action="store_true", help="skip cases that need the network or Firefox")
    ap.add_argument("--verbose", action="store_true", help="print every case, not just the failures")
    args = ap.parse_args()

    if args.no_live:
        os.environ["HYPERCORE_TEST_LIVE"] = "0"

    coverage: dict[str, list[str]] = {}
    for name in MODULES:
        if args.server and name != f"test_{args.server}":
            continue
        module = __import__(f"serve.mcp.tests.{name}", fromlist=[name])
        coverage[getattr(module, "SERVER", name)] = advertised(module)

    rec = Recorder()
    t0 = time.monotonic()
    build_suite(args.server).run(rec)
    elapsed = int((time.monotonic() - t0) * 1000)

    servers = aggregate(rec.rows, coverage)
    totals = {k: sum(s.get(k, 0) for s in servers.values()) for k in OUTCOMES}
    totals["cases"] = len(rec.rows)
    totals["ok"] = totals["fail"] == 0 and totals["error"] == 0
    totals["elapsed_ms"] = elapsed

    report = {
        "generated": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "python": sys.version.split()[0],
        "repo": str(harness.REPO),
        "live": os.environ.get("HYPERCORE_TEST_LIVE", "1").strip().lower()
                 not in {"0", "false", "no", "off"},
        "servers": servers,
        "uncovered": uncovered(servers),
        "totals": totals,
        "rows": rec.rows,
        "report_path": args.json,
    }

    if args.compare and Path(args.compare).is_file():
        report["diff"] = diff_with(json.loads(Path(args.compare).read_text(encoding="utf-8")), report)

    Path(args.json).parent.mkdir(parents=True, exist_ok=True)
    Path(args.json).write_text(json.dumps(report, indent=1), encoding="utf-8")

    print_report(report, args.verbose)
    for line in report.get("diff", []):
        print(f"  DIFF {line}")
    return 0 if totals["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
